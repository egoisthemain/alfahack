{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alfa ML response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "application_id",
    "feature_schema_version",
    "model_id",
    "pd",
    "pd_grade",
    "prediction_horizon_months",
    "calibration_method",
    "training_data_type"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "feature_schema_version": {
      "type": "string",
      "const": "alpha-v1.1-unified-features-1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "pd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pd_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "prediction_horizon_months": {
      "type": "integer",
      "const": 12
    },
    "calibration_method": {
      "type": "string",
      "enum": [
        "raw",
        "isotonic"
      ]
    },
    "training_data_type": {
      "type": "string",
      "const": "synthetic_counterfactuals"
    }
  }
}
