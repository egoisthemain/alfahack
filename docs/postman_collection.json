{
  "info": {
    "name": "Alfa demo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "applicationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Demo companies",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/companies"
      }
    },
    {
      "name": "Company profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/companies/7700000001"
      }
    },
    {
      "name": "Demo login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/demo/login",
        "body": {
          "mode": "raw",
          "raw": "{\"role\": \"client\", \"inn\": \"7700000001\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications",
        "body": {
          "mode": "raw",
          "raw": "{\"inn\": \"7700000001\", \"product\": \"EXPRESS\", \"amount\": 2000000, \"term_months\": 24, \"purpose\": \"Working capital\", \"annual_revenue\": 24000000, \"bki_consent\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"applicationId\", String(pm.response.json().application_id));"
            ]
          }
        }
      ]
    },
    {
      "name": "List applications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications"
      }
    },
    {
      "name": "Application details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/detail"
      }
    },
    {
      "name": "Submit draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/submit"
      }
    },
    {
      "name": "Run checks and inference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/process"
      }
    },
    {
      "name": "Transition history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/history"
      }
    },
    {
      "name": "Revise consent or document",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"bki_consent\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Analyst decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\"decision\": \"APPROVED\", \"amount\": 2000000, \"comment\": \"Synthetic documents checked\", \"reason_code\": \"R02\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Accept terms",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/accept-offer"
      }
    },
    {
      "name": "Decline counteroffer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/decline-offer"
      }
    },
    {
      "name": "Simulated sign and issue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/sign"
      }
    },
    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/applications/{{applicationId}}/withdraw"
      }
    }
  ]
}