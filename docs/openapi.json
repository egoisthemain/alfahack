  "components": {
    "securitySchemes": {
      "demoSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "alfahack_session"
      }
    },
    "schemas": {
      "ApplicationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inn",
          "product",
          "amount",
          "term_months",
          "purpose",
          "annual_revenue",
          "bki_consent"
        ],
        "properties": {
          "inn": {
            "type": "string"
          },
          "product": {
            "type": "string",
            "enum": [
              "EXPRESS",
              "EQUIPMENT"
            ]
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "term_months": {
            "type": "integer"
          },
          "purpose": {
            "type": "string"
          },
          "annual_revenue": {
            "type": "integer",
            "format": "int64"
          },
          "bki_consent": {
            "type": "boolean"
          },
          "equipment_cost": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "supplier_document_id": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
